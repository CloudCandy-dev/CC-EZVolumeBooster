{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers（静的アセット配信）用設定
  // Worker名は Cloudflare 側で作成したプロジェクト名に合わせる
  "name": "cc-ezvolumebooster",
  "compatibility_date": "2026-11-10",
  "observability": {
    "enabled": true
  },
  // public/index.html を /CC-EZVolumeBooster 配下で配信する
  // （directory にリポジトリ直下を指定すると .git までアップロードされるため専用フォルダを使う）
  // ルートはダッシュボード側で追加済みのため、ここには書かない
  "assets": {
    "directory": "./public",
    "base_path": "/CC-EZVolumeBooster",
    "not_found_handling": "single-page-application"
  }
}
